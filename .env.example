# AegisBreach settings. Copy to .env (git-ignored) and fill in real values.
# Start the API with:  cd backend && uvicorn app.main:app --env-file ../.env

# Required in the X-API-Key header for every /api/v1 route except /health.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is rejected by the server on purpose; replace it.
AEGIS_API_KEY=your-secure-key-here

# "development" allows requests WITHOUT a key, but only while AEGIS_API_KEY is empty.
# Any other value (or unset) rejects protected routes until a real key is set.
AEGIS_ENV=production

# Comma-separated browser origins allowed to call the API (CORS).
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
